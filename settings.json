{
  // Language-Specific Settings
  "[python]": {
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },

  // General Editor Enhancements
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.fontSize": 20,
  "editor.minimap.enabled": false,
  "editor.rulers": [80, 120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.showFoldingControls": "always",
  "editor.renderControlCharacters": false,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,

  // File and Project Settings
  "files.associations": {
    "*.erb": "erb",
    "*.vue": "vue"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/tmp": true,
    "**/dist": true,
    "**/build": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.vscode": true
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Emmet and Linting
  "emmet.includeLanguages": {
    "erb": "html",
    "vue-html": "html",
    "javascript": "javascriptreact"
  },
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,
  "css.lint.unknownAtRules": "ignore",

  // Git and Version Control
  "git.enabled": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.enableSmartCommit": true,

  // Search and Exclusions
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/__pycache__": true
  },

  // Terminal Settings
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.scrollback": 10000,

  // Notebook Settings
  "notebook.diff.ignoreMetadata": true,
  "notebook.lineNumbers": "on",
  "notebook.markup.fontSize": 13,

  // Telemetry and Performance
  "telemetry.telemetryLevel": "off",
  "window.restoreWindows": "none",
  "window.newWindowDimensions": "maximized",
  "window.zoomLevel": 0,

  // Workbench UI
  "workbench.colorTheme": "Shades of Purple (Super Dark)",
  "workbench.iconTheme": "vscode-great-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.panel.defaultLocation": "right",

  // TypeScript and Vue.js
  "typescript.tsdk": "node_modules/typescript/lib",
  "vue.useWorkspaceTsdk": true,

  // Java Settings (Red Hat Java Extension)
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "java.format.settings.profile": "GoogleStyle",
  "java.format.enabled": true,
  "java.help.showReleaseNotes": false,
  "java.compile.nullAnalysis.mode": "automatic",
  "java.errors.incompleteClasspath.severity": "warning",

  // Lombok Support
  "java.configuration.annotationProcessing.enabled": true,
  "java.configuration.updateBuildConfiguration": "automatic",

  // Live Server
  "liveServer.settings.donotShowInfoMsg": true,

  // GitHub Copilot (Optional)
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": true
  },
  "cSpell.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "github.copilot.nextEditSuggestions.enabled": true
}
